<header class="site-header">

  <div class="wrapper">

    <a class="site-title" rel="author" href="{{ "/" | relative_url }}">{{ site.title }}</a>

    <nav class="site-nav">
      <ul class="nav-list">
        {% for page in site.header_pages %}
        <li class="nav-item">
          <a class="page-link" href="{{ page.url | relative_url }}">{{ page.title }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>

  </div>

</header>
